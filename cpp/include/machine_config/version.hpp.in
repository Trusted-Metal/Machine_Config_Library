#pragma once
// Generated by CMake's configure_file() at configure time from this .in
// template — the real file (build/generated_include/machine_config/version.hpp)
// is never edited directly and is not committed.
//
// project(machine_config VERSION ...)'s own VERSION field can only hold
// CMake's numeric-only version syntax (major.minor.patch.tweak) — it
// hard-errors on a semver prerelease/build suffix like "-rc.4" (verified
// directly: `project(x VERSION 0.2.0-rc.4)` -> "VERSION \"0.2.0-rc.4\" format
// invalid."). During this project's current release phase every build is a
// prerelease (every commit to `main` releases as an rc.N per .releaserc.json),
// so CMake's own PROJECT_VERSION is identical across every one of those
// builds and can't distinguish rc.4 from rc.5. This header exists so the
// library can still report its *real*, full version — the one thing CMake's
// native VERSION field structurally cannot hold.

namespace machine_config {

// The complete version string, including any prerelease/build-metadata
// suffix — kept in sync with package.json by scripts/sync-version.mjs via
// cpp/cmake/Version.cmake, independently of CMake's own truncated
// PROJECT_VERSION. e.g. "0.2.0-rc.4", not just "0.2.0".
inline constexpr const char* kVersionString = "@MACHINE_CONFIG_FULL_VERSION@";

} // namespace machine_config
