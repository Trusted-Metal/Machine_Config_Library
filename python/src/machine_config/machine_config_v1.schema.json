{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MachineConfig",
  "type": "object",
  "required": ["meta", "machine", "optical_trains"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "machine_name", "manufacturer", "model", "serial_number",
                   "file_version", "export_date", "configuration_hash"],
      "properties": {
        "schema_version":      { "type": "string" },
        "machine_name":        { "type": "string" },
        "manufacturer":        { "type": "string" },
        "model":               { "type": "string" },
        "serial_number":       { "type": "string" },
        "file_version":        { "type": "string" },
        "export_date":         { "type": "string", "format": "date-time" },
        "configuration_hash":  { "type": "string", "minLength": 64, "maxLength": 64 },
        "extra": {
          "type": "object",
          "additionalProperties": { "type": ["string", "integer", "number"] }
        }
      }
    },
    "machine": {
      "type": "object",
      "properties": {
        "id":                      { "type": ["string", "null"] },
        "machine_name":            { "type": ["string", "null"] },
        "manufacturer":            { "type": ["string", "null"] },
        "model":                   { "type": ["string", "null"] },
        "serial_number":           { "type": ["string", "null"] },
        "build_plate_x":           { "type": ["number", "null"] },
        "build_plate_x_unit":      { "type": ["string", "null"] },
        "build_plate_y":           { "type": ["number", "null"] },
        "build_plate_y_unit":      { "type": ["string", "null"] },
        "build_plate_z":           { "type": ["number", "null"] },
        "build_plate_z_unit":      { "type": ["string", "null"] },
        "build_plate_radius":      { "type": ["number", "null"] },
        "build_plate_radius_unit": { "type": ["string", "null"] },
        "gas_flow_direction":      { "type": ["string", "null"] },
        "recoat_direction":        { "type": ["string", "null"] },
        "recoater_blade_type":     { "type": ["string", "null"] }
      }
    },
    "optical_trains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["train_id", "scanner", "light_source", "collimator", "scanner_card"],
        "properties": {
          "train_id":                                   { "type": "string" },
          "beam_waist_major":                           { "type": ["number", "null"] },
          "beam_waist_major_unit":                      { "type": ["string", "null"] },
          "beam_waist_minor":                           { "type": ["number", "null"] },
          "beam_waist_minor_unit":                      { "type": ["string", "null"] },
          "beam_waist_offset_z":                        { "type": ["number", "null"] },
          "beam_waist_offset_z_unit":                   { "type": ["string", "null"] },
          "m2_major":                                   { "type": ["number", "null"] },
          "m2_minor":                                   { "type": ["number", "null"] },
          "rayleigh_length_major":                      { "type": ["number", "null"] },
          "rayleigh_length_major_unit":                 { "type": ["string", "null"] },
          "rayleigh_length_minor":                      { "type": ["number", "null"] },
          "rayleigh_length_minor_unit":                 { "type": ["string", "null"] },
          "thermal_lensing_passed":                     { "type": ["boolean", "null"] },
          "thermal_lensing_focal_plane_shift":          { "type": ["number", "null"] },
          "thermal_lensing_focal_plane_shift_unit":     { "type": ["string", "null"] },
          "thermal_lensing_threshold":                  { "type": ["number", "null"] },
          "thermal_lensing_threshold_unit":             { "type": ["string", "null"] },
          "id":                                          { "type": ["string", "null"] },
          "beam_profile_type":                           { "type": ["string", "null"] },
          "beam_waist_definition":                       { "type": ["string", "null"] },
          "build_plane_offset_major":                    { "type": ["number", "null"] },
          "build_plane_offset_major_unit":               { "type": ["string", "null"] },
          "build_plane_offset_minor":                    { "type": ["number", "null"] },
          "build_plane_offset_minor_unit":               { "type": ["string", "null"] },
          "collimator_focal_length":                     { "type": ["number", "null"] },
          "collimator_focal_length_unit":                { "type": ["string", "null"] },
          "major_axis_angle":                            { "type": ["number", "null"] },
          "major_axis_angle_unit":                       { "type": ["string", "null"] },
          "scanner_number":                              { "type": ["string", "null"] },
          "scanner": {
            "type": "object",
            "properties": {
              "manufacturer":           { "type": "string" },
              "model":                  { "type": "string" },
              "serial_number":          { "type": "string" },
              "working_distance":        { "type": ["number", "null"] },
              "working_distance_unit":   { "type": ["string", "null"] },
              "scan_field_x":            { "type": ["number", "null"] },
              "scan_field_x_unit":       { "type": ["string", "null"] },
              "scan_field_y":            { "type": ["number", "null"] },
              "scan_field_y_unit":       { "type": ["string", "null"] },
              "scan_field_z":            { "type": ["number", "null"] },
              "scan_field_z_unit":       { "type": ["string", "null"] },
              "scan_head_offset_x":      { "type": ["number", "null"] },
              "scan_head_offset_x_unit": { "type": ["string", "null"] },
              "scan_head_offset_y":      { "type": ["number", "null"] },
              "scan_head_offset_y_unit": { "type": ["string", "null"] },
              "scan_head_offset_z":      { "type": ["number", "null"] },
              "scan_head_offset_z_unit": { "type": ["string", "null"] },
              "scan_head_rotation":      { "type": ["number", "null"] },
              "scan_head_rotation_unit": { "type": ["string", "null"] },
              "axis_configuration":      { "type": ["string", "null"] },
              "invert_actual_x":         { "type": "boolean", "description": "Omitted entirely (not present as false) unless true." },
              "invert_actual_y":         { "type": "boolean", "description": "Omitted entirely (not present as false) unless true." },
              "invert_commanded_x":      { "type": "boolean", "description": "Omitted entirely (not present as false) unless true." },
              "invert_commanded_y":      { "type": "boolean", "description": "Omitted entirely (not present as false) unless true." },
              "x_axis": {
                "type": ["object", "null"],
                "properties": {
                  "actual_bit_resolution":       { "type": ["integer", "null"] },
                  "actual_bit_resolution_unit":  { "type": ["string", "null"] },
                  "commanded_bit_resolution":    { "type": ["integer", "null"] },
                  "commanded_bit_resolution_unit": { "type": ["string", "null"] },
                  "control_type":         { "type": ["string", "null"] },
                  "range_of_motion":      { "type": ["number", "null"] },
                  "range_of_motion_unit": { "type": ["string", "null"] },
                  "smoothing_kernel":     { "type": ["string", "null"] },
                  "smoothing_parameters": { "type": ["number", "null"] },
                  "tuning_parameters":    { "type": ["string", "null"] },
                  "tuning_type":          { "type": ["string", "null"] }
                }
              },
              "y_axis": {
                "type": ["object", "null"],
                "properties": {
                  "actual_bit_resolution":       { "type": ["integer", "null"] },
                  "actual_bit_resolution_unit":  { "type": ["string", "null"] },
                  "commanded_bit_resolution":    { "type": ["integer", "null"] },
                  "commanded_bit_resolution_unit": { "type": ["string", "null"] },
                  "control_type":         { "type": ["string", "null"] },
                  "range_of_motion":      { "type": ["number", "null"] },
                  "range_of_motion_unit": { "type": ["string", "null"] },
                  "smoothing_kernel":     { "type": ["string", "null"] },
                  "smoothing_parameters": { "type": ["number", "null"] },
                  "tuning_parameters":    { "type": ["string", "null"] },
                  "tuning_type":          { "type": ["string", "null"] }
                }
              },
              "z_axis": {
                "type": ["object", "null"],
                "properties": {
                  "actual_bit_resolution":       { "type": ["integer", "null"] },
                  "actual_bit_resolution_unit":  { "type": ["string", "null"] },
                  "commanded_bit_resolution":    { "type": ["integer", "null"] },
                  "commanded_bit_resolution_unit": { "type": ["string", "null"] },
                  "control_type":         { "type": ["string", "null"] },
                  "range_of_motion":      { "type": ["number", "null"] },
                  "range_of_motion_unit": { "type": ["string", "null"] },
                  "smoothing_kernel":     { "type": ["string", "null"] },
                  "smoothing_parameters": { "type": ["number", "null"] },
                  "tuning_parameters":    { "type": ["string", "null"] },
                  "tuning_type":          { "type": ["string", "null"] }
                }
              },
              "focus": {
                "type": ["object", "null"],
                "properties": {
                  "actual_bit_resolution":       { "type": ["integer", "null"] },
                  "actual_bit_resolution_unit":  { "type": ["string", "null"] },
                  "commanded_bit_resolution":    { "type": ["integer", "null"] },
                  "commanded_bit_resolution_unit": { "type": ["string", "null"] },
                  "control_type":         { "type": ["string", "null"] },
                  "range_of_motion":      { "type": ["number", "null"] },
                  "range_of_motion_unit": { "type": ["string", "null"] },
                  "smoothing_kernel":     { "type": ["string", "null"] },
                  "smoothing_parameters": { "type": ["number", "null"] },
                  "tuning_parameters":    { "type": ["string", "null"] },
                  "tuning_type":          { "type": ["string", "null"] }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["axis_configuration"],
                  "properties": { "axis_configuration": { "const": "3D" } }
                },
                "then": { "required": ["x_axis", "y_axis", "z_axis"] }
              },
              {
                "if": {
                  "required": ["axis_configuration"],
                  "properties": { "axis_configuration": { "const": "2D" } }
                },
                "then": { "required": ["x_axis", "y_axis"] }
              },
              {
                "if": {
                  "required": ["axis_configuration"],
                  "properties": { "axis_configuration": { "const": "3D+Focus" } }
                },
                "then": { "required": ["x_axis", "y_axis", "z_axis", "focus"] }
              }
            ]
          },
          "light_source": {
            "type": "object",
            "properties": {
              "manufacturer":             { "type": "string" },
              "model":                    { "type": "string" },
              "serial_number":            { "type": "string" },
              "wavelength":               { "type": ["number", "null"] },
              "wavelength_unit":          { "type": ["string", "null"] },
              "power_max_nominal":        { "type": ["number", "null"] },
              "power_max_nominal_unit":   { "type": ["string", "null"] },
              "power_max_actual":         { "type": ["number", "null"] },
              "power_max_actual_unit":    { "type": ["string", "null"] },
              "power_min_actual":         { "type": ["number", "null"] },
              "power_min_actual_unit":    { "type": ["string", "null"] },
              "power_min_nominal":        { "type": ["number", "null"] },
              "power_min_nominal_unit":   { "type": ["string", "null"] },
              "power_bit_resolution":     { "type": ["number", "null"] },
              "power_bit_resolution_unit":{ "type": ["string", "null"] },
              "power_characterization": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "algorithm_type":         { "type": ["string", "null"] },
                  "algorithm_equation":     { "type": ["string", "null"] },
                  "input_type":             { "type": ["string", "null"] },
                  "units_derived_quantity": { "type": ["string", "null"] },
                  "derivation_equation_constants": {
                    "type": ["array", "null"],
                    "items": {
                      "type": "object",
                      "properties": {
                        "name":  { "type": "string" },
                        "value": { "type": "number" }
                      }
                    }
                  },
                  "characterization_points": {
                    "type": ["array", "null"],
                    "items": {
                      "type": "object",
                      "properties": {
                        "input_value":  { "type": "number" },
                        "output_value": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          },
          "collimator": {
            "type": "object",
            "properties": {
              "manufacturer":    { "type": "string" },
              "model":           { "type": "string" },
              "serial_number":   { "type": "string" },
              "focal_length":      { "type": ["number", "null"] },
              "focal_length_unit": { "type": ["string", "null"] }
            }
          },
          "scanner_card": {
            "type": "object",
            "properties": {
              "manufacturer":           { "type": "string" },
              "model":                  { "type": "string" },
              "serial_number":          { "type": "string" },
              "communication_protocol": { "type": ["string", "null"] },
              "sample_period":          { "type": ["number", "null"] },
              "sample_period_unit":     { "type": ["string", "null"] }
            }
          },
          "scan_field_correction_file": {
            "type": ["object", "null"],
            "properties": {
              "document_name":       { "type": "string" },
              "document_id":         { "type": "string" },
              "file_size":           { "type": "integer" },
              "valid_as_of_date":    { "type": "string" },
              "document_created_at": { "type": ["string", "null"] },
              "document_type":       { "type": ["string", "null"] },
              "original_uri":        { "type": ["string", "null"] },
              "raw_bytes":           { "type": ["string", "null"], "contentEncoding": "base64" }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Opaque extension trees keyed by group name under Extensions/. Core reads and writes them verbatim; the tree shape ({attrs, children, datasets}, each attribute {dtype, value}) is defined by docs/EXTENSION_CONTRACT.md and enforced by the extension contract validator, not by this schema. Not required; an absent or empty object means no extensions.",
      "additionalProperties": { "type": "object" }
    }
  }
}
